# ============================================================================
# Bina Analytics Control Center - Environment Configuration
# ============================================================================
# This file contains all environment variables needed to run Bina Analytics.
# Copy this file to .env and fill in your actual values.
# NEVER commit .env file to version control!
# ============================================================================

# ----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# ----------------------------------------------------------------------------

# Application Identity
VITE_APP_NAME=Bina Analytics Control Center
VITE_APP_SHORT_NAME=Bina
VITE_APP_VERSION=4.0.0
VITE_APP_DESCRIPTION=Intelligence-Driven Analytics Platform

# Environment
VITE_ENVIRONMENT=development
# Options: development, staging, production

# Logging
VITE_LOG_LEVEL=info
# Options: debug, info, warn, error

# ----------------------------------------------------------------------------
# SUPABASE CONFIGURATION (REQUIRED)
# ----------------------------------------------------------------------------

# Supabase Project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Key (Public)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (Server-side only, DO NOT expose to client)
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ----------------------------------------------------------------------------
# BRANDING & THEME
# ----------------------------------------------------------------------------

# Primary Brand Color (Hex)
VITE_BRAND_PRIMARY=#0052A3

# Secondary Brand Color (Hex)
VITE_BRAND_SECONDARY=#00B894

# Accent Color (Hex)
VITE_BRAND_ACCENT=#FF6B00

# Logo URLs (Optional - can be served from assets/)
VITE_LOGO_LIGHT=/assets/logos/bina-logo-light.svg
VITE_LOGO_DARK=/assets/logos/bina-logo-dark.svg
VITE_LOGO_ICON=/assets/logos/bina-icon.svg

# Font Configuration
VITE_FONT_HEADING=Inter
VITE_FONT_BODY=Inter
VITE_FONT_MONO=JetBrains Mono

# ----------------------------------------------------------------------------
# FEATURE FLAGS
# ----------------------------------------------------------------------------

# Core Features
VITE_ENABLE_AUTHENTICATION=true
VITE_ENABLE_GUEST_MODE=false
VITE_ENABLE_MULTI_USER=true

# Trading Features
VITE_ENABLE_TRADING=true
VITE_ENABLE_PAPER_TRADING=true
VITE_ENABLE_LIVE_TRADING=true

# Analytics Features
VITE_ENABLE_PORTFOLIO_ANALYTICS=true
VITE_ENABLE_BACKTESTING=true
VITE_ENABLE_CUSTOM_INDICATORS=true
VITE_ENABLE_REPORT_BUILDER=true

# Data Features
VITE_ENABLE_NEWS=true
VITE_ENABLE_ECONOMICS=true
VITE_ENABLE_GEOPOLITICS=true
VITE_ENABLE_MARITIME=true
VITE_ENABLE_SCREENER=true

# Advanced Features
VITE_ENABLE_NODE_EDITOR=true
VITE_ENABLE_CODE_EDITOR=true
VITE_ENABLE_MCP_SERVERS=true
VITE_ENABLE_JUPYTER=false

# Legacy Features (Disable for Bina)
VITE_ENABLE_MARKETPLACE=false
VITE_ENABLE_PAYMENT=false
VITE_ENABLE_FORUM=false
VITE_ENABLE_PRICING_SCREEN=false

# ----------------------------------------------------------------------------
# DATA SOURCE API KEYS
# ----------------------------------------------------------------------------

# Market Data Providers
VITE_ALPHA_VANTAGE_KEY=
VITE_POLYGON_KEY=
VITE_FINANCIAL_MODELING_PREP_KEY=
VITE_TIINGO_KEY=
VITE_QUANDL_KEY=

# Economic Data
VITE_FRED_API_KEY=
VITE_WORLD_BANK_API_KEY=
VITE_IMF_API_KEY=
VITE_BIS_API_KEY=

# News APIs
VITE_NEWS_API_KEY=
VITE_MARKETAUX_KEY=

# Geospatial Data
VITE_MAPBOX_KEY=
VITE_NASA_API_KEY=

# ----------------------------------------------------------------------------
# LLM PROVIDER CONFIGURATION
# ----------------------------------------------------------------------------

# OpenAI
VITE_OPENAI_API_KEY=
VITE_OPENAI_ORG_ID=
VITE_OPENAI_DEFAULT_MODEL=gpt-4-turbo-preview

# Anthropic
VITE_ANTHROPIC_API_KEY=
VITE_ANTHROPIC_DEFAULT_MODEL=claude-3-sonnet-20240229

# Google Gemini
VITE_GOOGLE_AI_KEY=
VITE_GOOGLE_DEFAULT_MODEL=gemini-pro

# DeepSeek
VITE_DEEPSEEK_API_KEY=
VITE_DEEPSEEK_DEFAULT_MODEL=deepseek-chat

# OpenRouter
VITE_OPENROUTER_API_KEY=
VITE_OPENROUTER_DEFAULT_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Ollama (Local)
VITE_OLLAMA_HOST=http://localhost:11434
VITE_OLLAMA_DEFAULT_MODEL=llama2

# LLM Configuration
VITE_DEFAULT_LLM_PROVIDER=ollama
# Options: openai, anthropic, google, deepseek, openrouter, ollama

VITE_LLM_TEMPERATURE=0.7
VITE_LLM_MAX_TOKENS=2000

# ----------------------------------------------------------------------------
# BROKER INTEGRATIONS
# ----------------------------------------------------------------------------

# Fyers (India)
VITE_FYERS_APP_ID=
VITE_FYERS_SECRET_KEY=

# Zerodha Kite (India)
VITE_ZERODHA_API_KEY=
VITE_ZERODHA_API_SECRET=

# Interactive Brokers
VITE_IBKR_ACCOUNT_ID=
VITE_IBKR_HOST=localhost
VITE_IBKR_PORT=7497

# Kraken (Crypto)
VITE_KRAKEN_API_KEY=
VITE_KRAKEN_API_SECRET=

# Hyperliquid
VITE_HYPERLIQUID_TESTNET=true

# ----------------------------------------------------------------------------
# N8N WORKFLOW AUTOMATION
# ----------------------------------------------------------------------------

# n8n Instance URL
VITE_N8N_WEBHOOK_URL=http://localhost:5678/webhook
VITE_N8N_API_URL=http://localhost:5678/api/v1
VITE_N8N_API_KEY=

# n8n Features
VITE_ENABLE_N8N_WORKFLOWS=true
VITE_ENABLE_N8N_WEBHOOKS=true

# ----------------------------------------------------------------------------
# MCP (Model Context Protocol) SERVERS
# ----------------------------------------------------------------------------

# Enable MCP Features
VITE_ENABLE_MCP=true

# MCP Server Configuration
VITE_MCP_AUTO_START=true
VITE_MCP_TIMEOUT=30000

# ----------------------------------------------------------------------------
# STORAGE & CACHING
# ----------------------------------------------------------------------------

# Local Storage Prefix
VITE_STORAGE_PREFIX=bina_

# Cache Settings
VITE_CACHE_TTL=3600
VITE_ENABLE_OFFLINE_MODE=true

# SQLite Database
VITE_SQLITE_DB_NAME=bina_analytics.db

# ----------------------------------------------------------------------------
# SECURITY CONFIGURATION
# ----------------------------------------------------------------------------

# CORS Settings
VITE_CORS_ENABLED=true
VITE_CORS_ALLOWED_ORIGINS=http://localhost:1420,http://localhost:5173

# Rate Limiting
VITE_RATE_LIMIT_ENABLED=true
VITE_RATE_LIMIT_REQUESTS=100
VITE_RATE_LIMIT_WINDOW=60000

# Session Settings
VITE_SESSION_TIMEOUT=3600000
# Session timeout in milliseconds (1 hour = 3600000)

# ----------------------------------------------------------------------------
# ANALYTICS & MONITORING
# ----------------------------------------------------------------------------

# Application Insights (Optional)
VITE_APP_INSIGHTS_KEY=

# Sentry Error Tracking (Optional)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

# Usage Analytics
VITE_ENABLE_ANALYTICS=false
VITE_ANALYTICS_ID=

# ----------------------------------------------------------------------------
# UPDATE CONFIGURATION
# ----------------------------------------------------------------------------

# Auto-update Settings
VITE_ENABLE_AUTO_UPDATE=true
VITE_UPDATE_CHECK_INTERVAL=3600000
# Check for updates every hour

# Update Server
VITE_UPDATE_SERVER_URL=https://github.com/adamint8/Bina-Terminal/releases/latest/download/latest.json

# ----------------------------------------------------------------------------
# DEVELOPMENT & DEBUGGING
# ----------------------------------------------------------------------------

# Development Mode
VITE_DEV_MODE=true

# Debug Features
VITE_ENABLE_DEBUG_PANEL=false
VITE_ENABLE_PERFORMANCE_MONITORING=false

# API Mocking
VITE_ENABLE_API_MOCKING=false
VITE_MOCK_DELAY=1000

# ----------------------------------------------------------------------------
# EXPERIMENTAL FEATURES
# ----------------------------------------------------------------------------

# Beta Features
VITE_ENABLE_BETA_FEATURES=false

# Feature Experiments
VITE_EXPERIMENT_REALTIME_COLLAB=false
VITE_EXPERIMENT_ADVANCED_CHARTS=false
VITE_EXPERIMENT_CUSTOM_DASHBOARDS=false

# ----------------------------------------------------------------------------
# CONTACT & SUPPORT
# ----------------------------------------------------------------------------

# Support Configuration
VITE_SUPPORT_EMAIL=support@bina-analytics.com
VITE_SUPPORT_URL=https://bina-analytics.com/support
VITE_DOCUMENTATION_URL=https://docs.bina-analytics.com

# Social Links
VITE_SOCIAL_TWITTER=
VITE_SOCIAL_LINKEDIN=
VITE_SOCIAL_GITHUB=https://github.com/adamint8/Bina-Terminal

# ----------------------------------------------------------------------------
# LEGAL & COMPLIANCE
# ----------------------------------------------------------------------------

# Legal URLs
VITE_TERMS_URL=https://bina-analytics.com/terms
VITE_PRIVACY_URL=https://bina-analytics.com/privacy
VITE_LICENSE_URL=https://bina-analytics.com/license

# Company Information
VITE_COMPANY_NAME=Bina Analytics
VITE_COMPANY_WEBSITE=https://bina-analytics.com

# ============================================================================
# END OF CONFIGURATION
# ============================================================================

# Notes:
# 1. Keep this file updated as new features are added
# 2. Never commit actual credentials
# 3. Use different values for development, staging, and production
# 4. Consult documentation for detailed explanations
# 5. Required fields are marked with (REQUIRED)
# 6. Optional fields can be left empty

